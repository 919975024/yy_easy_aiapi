            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/admin/login": {
      "get": {
        "tags": ["管理员认证"],
        "summary": "管理员登录页面",
        "description": "返回管理员登录页面的 HTML。当配置了用户名时，访问管理后台前需先在此页面登录。",
        "operationId": "loginPage",
        "responses": {
          "200": {
            "description": "成功返回登录页面 HTML",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string",
                  "description": "管理员登录页面 HTML"
                }
              }
            }
          }
        }
      }
    },
    "/admin/login/api": {
      "post": {
        "tags": ["管理员认证"],
        "summary": "管理员登录 API",
        "description": "管理员登录认证。\n\n- 连续 5 次登录失败将锁定 10 分钟\n- 锁定状态在程序重启后重置\n- 登录成功后需将 session_token 存入 Cookie（key: admin_session）\n\n### 请求示例\n```json\n{\n  \"username\": \"admin\",\n  \"password\": \"your_password\"\n}\n```\n\n### 响应示例（成功）\n```json\n{\n  \"success\": true,\n  \"message\": \"登录成功\",\n  \"session_token\": \"uuid-string\"\n}\n```\n\n### 响应示例（失败）\n```json\n{\n  \"success\": false,\n  \"error\": {\n    \"code\": 401,\n    \"message\": \"用户名或密码错误，剩余尝试次数: 4\"\n  }\n}\n```",
        "operationId": "loginApi",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": {
                    "type": "string",
                    "description": "管理员用户名（需在配置文件中设置）",
                    "example": "admin"
                  },
                  "password": {
                    "type": "string",
                    "description": "管理员密码",
                    "format": "password",
                    "example": "your_password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功，返回 session_token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "session_token": {
                      "type": "string",
                      "description": "会话 Token，需存入 Cookie（key: admin_session）",
                      "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
                    },
                    "message": { "type": "string", "example": "登录成功" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "用户名或密码错误",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "429": {
            "description": "登录已锁定（连续 5 次错误，锁定 10 分钟）",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/admin/logout/api": {
      "post": {
        "tags": ["管理员认证"],
        "summary": "管理员登出 API",
        "description": "管理员登出，清除当前会话。\n\n### 响应示例\n```json\n{\n  \"success\": true,\n  \"message\": \"已退出登录\"\n}\n```",
