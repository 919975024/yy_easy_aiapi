                    "message": { "type": "string", "example": "已退出登录" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "TokenAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "AI 代理鉴权。使用系统生成的 Token（UUID 格式）。\n\n请求头格式：\n```\nAuthorization: Bearer {token}\n```\n\nToken 通过管理 API（POST /api/token/generate）生成。"
      },
      "ApiTokenAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "UUID",
        "description": "管理 API 鉴权。使用配置的 api_token（UUID 格式）。\n\n请求头格式：\n```\nAuthorization: Bearer {api_token}\n```\n\napi_token 在 config.toml 的 [admin] 节中配置。\n\n此 Token 可用于所有 /api/* 和 /admin/*/api 接口。"
      }
    },
    "schemas": {
      "ChannelInfo": {
        "type": "object",
        "description": "渠道信息",
        "properties": {
          "id": { "type": "integer", "format": "int64", "description": "渠道 ID", "example": 1 },
          "name": { "type": "string", "description": "渠道名称（用于匹配 AI 请求中的 model 参数）", "example": "gpt-4o" },
          "api_standard": { "type": "string", "description": "API 协议标准", "example": "openai" },
          "price_input": { "type": "string", "description": "输入单价（元/百万Token）", "example": "10" },
          "price_cached": { "type": "string", "description": "缓存命中单价（元/百万Token）", "example": "5" },
          "price_output": { "type": "string", "description": "输出单价（元/百万Token）", "example": "30" },
          "rate_input": { "type": "string", "description": "输入 Token 汇率", "example": "1.0" },
          "rate_cached": { "type": "string", "description": "缓存 Token 汇率", "example": "1.0" },
          "rate_output": { "type": "string", "description": "输出 Token 汇率", "example": "1.0" },
          "upstream_url": { "type": "string", "description": "上游 API 地址", "example": "https://api.deepseek.com/v1" },
          "api_key": { "type": "string", "description": "上游 API 密钥", "example": "sk-xxx" },
          "channel_type": { "type": "string", "description": "渠道厂商类型（deepseek/volcengine/qwen/baidu/tencent/openai/anthropic/google/custom）", "example": "deepseek" },
          "price_reference_url": { "type": "string", "description": "计费价格参考链接", "example": "https://api-docs.deepseek.com/zh-cn/quick_start/pricing" },
          "model": { "type": "string", "description": "上游实际调用的模型名（为空则使用渠道名）", "example": "deepseek-chat" },
          "created_at": { "type": "string", "format": "date-time", "description": "创建时间", "example": "2025-01-01T00:00:00" },
          "updated_at": { "type": "string", "format": "date-time", "description": "更新时间", "example": "2025-01-01T00:00:00" }
        }
      },
      "TokenInfo": {
        "type": "object",
        "description": "Token 信息",
        "properties": {
          "id": { "type": "integer", "format": "int64", "description": "ID" },
          "token": { "type": "string", "description": "Token 值", "example": "8080_a1b2c3d4e5f6e7f8g9h0i1j2k3l4m5n6" },
          "label": { "type": "string", "description": "Token 标签", "example": "我的应用" },
          "balance": { "type": "string", "description": "当前余额（积分）", "example": "5000" },
          "created_at": { "type": "string", "format": "date-time", "description": "创建时间" },
          "max_concurrent": { "type": "integer", "description": "最大并发数", "example": 5 }
        }
      },
      "TokenGenerated": {
        "type": "object",
        "description": "Token 生成响应",
        "properties": {
          "token": { "type": "string", "description": "新生成的 Token 值", "example": "8080_a1b2c3d4e5f6e7f8g9h0i1j2k3l4m5n6" },
          "label": { "type": "string", "description": "Token 标签", "example": "我的应用" },
          "balance": { "type": "string", "description": "初始余额", "example": "0" }
        }
      },
      "BalanceInfo": {
        "type": "object",
        "description": "余额信息",
        "properties": {
          "token": { "type": "string", "description": "Token 值" },
          "label": { "type": "string", "description": "Token 标签" },
          "balance": { "type": "string", "description": "当前余额", "example": "5000" },
          "max_concurrent": { "type": "integer", "description": "最大并发数", "example": 5 }
        }
      },
      "OperationResult": {
        "type": "object",
        "description": "操作结果",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "description": "操作结果描述", "example": "充值成功" }
        }
      },
      "TransactionInfo": {
        "type": "object",
        "description": "流水记录（非管理员，基本字段）",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "token": { "type": "string", "description": "Token 值" },
          "token_prefix": { "type": "string", "description": "Token 前缀" },
          "label": { "type": "string", "description": "Token 标签" },
          "change_type": { "type": "string", "description": "变动类型（recharge/deduct/ask）", "example": "recharge" },
          "amount": { "type": "string", "description": "变动金额", "example": "+1000" },
          "balance_after": { "type": "string", "description": "变动后余额" },
          "channel_name": { "type": "string", "description": "渠道名" },
          "request_id": { "type": "string", "description": "请求 ID" },
          "operator": { "type": "string", "description": "操作者" },
          "metadata": { "type": "string", "description": "元数据" },
          "remark": { "type": "string", "description": "备注" },
          "created_at": { "type": "string", "format": "date-time", "description": "创建时间" }
        }
      },
      "AdminTransactionInfo": {
        "type": "object",
        "description": "流水记录（管理员，含计费详情）",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "token": { "type": "string" },
          "token_prefix": { "type": "string" },
          "label": { "type": "string" },
          "change_type": { "type": "string" },
          "amount": { "type": "string" },
          "balance_after": { "type": "string" },
          "channel_name": { "type": "string" },
          "request_id": { "type": "string" },
          "operator": { "type": "string" },
          "metadata": { "type": "string" },
          "remark": { "type": "string", "description": "备注" },
          "created_at": { "type": "string", "format": "date-time" },
          "input_tokens": { "type": "integer", "format": "int64", "description": "输入 Token 数" },
          "input_price": { "type": "string", "description": "输入单价" },
          "cached_tokens": { "type": "integer", "format": "int64", "description": "缓存 Token 数" },
          "cached_price": { "type": "string", "description": "缓存单价" },
          "output_tokens": { "type": "integer", "format": "int64", "description": "输出 Token 数" },
          "output_price": { "type": "string", "description": "输出单价" },
          "multiplier": { "type": "string", "description": "使用的倍率", "example": "1.0" }
        }
      },
      "TransactionPage": {
        "type": "object",
        "description": "分页流水（非管理员）",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TransactionInfo" }
          },
          "total": { "type": "integer", "description": "总记录数" },
          "page": { "type": "integer", "description": "当前页码" },
          "page_size": { "type": "integer", "description": "每页条数" }
        }
      },
      "AdminTransactionPage": {
        "type": "object",
        "description": "分页流水（管理员）",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AdminTransactionInfo" }
          },
          "total": { "type": "integer", "description": "总记录数" },
          "page": { "type": "integer", "description": "当前页码" },
          "page_size": { "type": "integer", "description": "每页条数" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "错误响应",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "data": { "type": "null" },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "integer", "example": 401 },
              "message": { "type": "string", "example": "鉴权失败" }
            }
          },
          "message": { "type": "string", "example": "鉴权失败" }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "鉴权失败 — Token 无效或未提供",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "BadRequest": {
        "description": "请求参数错误",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "NotFound": {
        "description": "资源不存在",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    }
  }
}