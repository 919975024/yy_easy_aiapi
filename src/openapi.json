    "/api/token/balance": {
      "get": {
        "tags": ["积分管理"],
        "summary": "查询 Token 余额",
        "description": "查询指定 Token 或标签下的余额信息。可以通过 token 或 label 参数查询。\n\n### 按 Token 查询\n```\nGET /api/token/balance?token=a1b2c3d4-...\n```\n\n### 按标签查询\n```\nGET /api/token/balance?label=我的应用\n```\n\n### 响应示例\n```json\n{\n  \"success\": true,\n  \"data\": [\n    {\n      \"token\": \"a1b2c3d4-...\",\n      \"label\": \"我的应用\",\n      \"balance\": \"5000\",\n      \"deleted\": false,\n      \"max_concurrent\": 5\n    }\n  ]\n}\n```",
        "operationId": "getBalance",
        "security": [{ "ApiTokenAuth": [] }],
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": false,
            "description": "Token 值（UUID 格式）。与 label 二选一",
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
            }
          },
          {
            "name": "label",
            "in": "query",
            "required": false,
            "description": "Token 标签。与 token 二选一",
            "schema": {
              "type": "string",
              "example": "我的应用"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回余额信息",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/BalanceInfo" }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "缺少 token 或 label 参数",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
