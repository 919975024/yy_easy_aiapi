              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/OperationResult" }
                  }
                }
              }
            }
          },
          "400": {
